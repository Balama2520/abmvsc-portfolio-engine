# Editor settings shared by every contributor, so a PR never arrives as a
# whitespace-only diff. Hand-authored SVG is left alone on purpose.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{jpg,jpeg,png,gif,ico,pdf,woff,woff2}]
insert_final_newline = false
